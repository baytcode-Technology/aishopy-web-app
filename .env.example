# Same backend the Expo app uses (EXPO_PUBLIC_API_URL).
# Local: http://localhost:5000  Production: https://api.aishopy.io
NEXT_PUBLIC_API_URL=https://api.aishopy.io

# Public URL of this merchant web app. Production: https://app.aishopy.io
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Customer shop host used for slug.domain preview (create-store).
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=aishopy.io

# Template preview iframe host. Defaults to https://{STOREFRONT_BASE_DOMAIN}.
NEXT_PUBLIC_STOREFRONT_PREVIEW_BASE_URL=https://aishopy.io

# Optional. Hide Google button when empty. Add http://localhost:3001/oauth
# as an authorized redirect URI on the Google Cloud web client.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
